<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NWmi.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: Identifiers should not contain underscores -->
    <!-- CA1861: Avoid constant arrays as arguments -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Wmio\Fixtures\*.objref" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\NWmi\NWmi.csproj" />
    <ProjectReference Include="..\..\src\NWmi.Cli\NWmi.Cli.csproj" />
  </ItemGroup>

</Project>
